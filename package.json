{
  "name": "geoplan-institucional",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare:preview": "node scripts/prepare-preview.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "build": "node scripts/build.mjs",
    "lint": "node --check js/main.js && node --check js/motion.js && html-validate index.html && node scripts/check-public.mjs",
    "test": "vitest run --coverage && node scripts/coverage-baseline.mjs",
    "test:coverage:record": "node scripts/coverage-baseline.mjs --record",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs --dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.25.12",
    "html-validate": "11.17.0",
    "jsdom": "30.1.3",
    "tailwindcss": "3.4.19",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "framer-motion": "14.7.1",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
